&CONTROL
     calculation = 'scf'
!     restart_mode = 'restart'
     prefix = 'Ni55'
     outdir = './tmp'
     pseudo_dir = './PPs/'
     verbosity = 'high'
     wf_collect = .true.
     tprnfor=.true.
     nstep = 300
/
&SYSTEM
    ibrav = 0,
    nat = 55,
    ntyp = 1,
    nbnd = 594,
    ecutwfc = 60,
    ecutrho = 480.0,
    input_dft = 'PBE',
    tot_charge = 0.0
    nspin = 2,
    starting_magnetization(1) = 0.6,
    occupations='smearing',
    smearing='m-v',
    degauss=0.01
    vdw_corr = 'grimme-d3',
    dftd3_version = 4
    dftd3_threebody = .false.
/

&ELECTRONS
    diagonalization='david'
    diago_full_acc = .true.
    conv_thr = 1.0d-8,
    mixing_beta = 0.1
    electron_maxstep=500
/
&IONS
    ion_positions = 'default'
    ion_dynamics = 'bfgs'
/
ATOMIC_SPECIES
Ni   58.69 ni_pbe_v1.4.uspp.F.UPF

K_POINTS (gamma)

CELL_PARAMETERS (angstrom)
  22.00000000000    0.0000000000    0.000000000
   0.00000000000   22.0000000000    0.000000000
   0.00000000000    0.0000000000   22.000000000
ATOMIC_POSITIONS (angstrom)
